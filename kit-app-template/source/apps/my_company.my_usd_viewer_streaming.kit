[package]
title = "My USD Viewer Streaming"
version = "0.1.0"
description = "Configuration for streaming deployments of My USD Viewer"
keywords = ["experience", "app", "dev", "streaming"]
template_name = "omni.streaming_configuration"

[dependencies]
"my_company.my_usd_viewer" = {}  # Application kit file
"omni.kit.livestream.app" = {}  # Livestream extension
"omni.physx" = {}
"omni.physx.stageupdate" = {}   # Real-time PhysX physics simulation support

[settings.app]
fastShutdown = true
name = "My USD Viewer Streaming"  # Application Display Name
renderer.resolution.height = 1080
renderer.resolution.width = 1920
window.height = 1080
window.width = 1920

[settings]
rtx.post.aa.op = 3
rtx.verifyDriverVersion.enabled = false

[settings.exts."omni.kit.livestream.app".primaryStream]
streamType = "webrtc"
signalPort = 49221
streamPort = 48021

# Run loop rate-limiting to stabilize frame pacing and prevent GPU compute spikes
[settings.app.runLoops.main]
rateLimitEnabled = true
rateLimitFrequency = 60

# Livestream encoder rate and framerate stability tuning
[settings.exts."omni.kit.livestream.core"]
videoFps = 60
videoBitrate = 10000000
maxFramerate = 60

[settings.app.extensions]
registryEnabled = true
supportedTargets.platform = []  # Skip checking supported platform/config when building

exclude = [
    "omni.kit.developer.bundle",
    "omni.kit.widget.cache_indicator",
]

[settings.app.exts]
folders.'++' = [  # Search paths for extensions.
    "${app}/../exts",
    "${app}/../apps",
    "${app}/../extscache"
]

[settings.app.file]
ignoreUnsavedOnExit = true

[template]
type = "ApplicationLayerTemplate" # Repo Template Metadata


